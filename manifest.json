{
  "manifest_version": 3,
  "name": "x_Wallet",
  "version": "3.0.3",
  "description": "x_Wallet is a next-gen crypto wallet with seamless, unmatched interoperability and interface on the market.",
  "background": {
    "service_worker": "service_worker/index.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://api.coingecko.com/*",
    "https://pro-api.coingecko.com/*",
    "https://pro-openapi.debank.com/*",
    "https://v2-api.l1xapp.com/*",
    "https://nlo.finance/*",
    "https://*.quiknode.pro/*",
    "https://*.publicnode.com/*",
    "https://*.onfinality.io/*",
    "https://api.avax.network/*",
    "https://mainnet.optimism.io/*",
    "https://v2-mainnet-rpc.l1x.foundation/*"
  ],
  "action": {
    "default_icon": {
      "16": "logo.png",
      "32": "logo.png",
      "48": "logo.png",
      "128": "logo.png"
    },
    "default_popup": "index.html"
  },
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content_script/index.js"
      ],
      "css": [],
      "run_at": "document_start",
      "type": "module"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon-128.png",
        "icon-34.png",
        "logo.png",
        "logo.png",
        "assets/js/*",
        "sdk/*",
        "ethereum_sdk/*",
        "*.type/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "<all_urls>"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
